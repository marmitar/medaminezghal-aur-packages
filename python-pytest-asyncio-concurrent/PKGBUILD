_name=pytest-asyncio-concurrent
pkgname=python-$_name
pkgver=0.5.2
pkgrel=1
pkgdesc='Pytest plugin to execute python async tests concurrently.'
arch=('any')
url='https://github.com/czl9707/pytest-asyncio-concurrent'
license=('MIT')
depends=('python' 'python-pytest')
makedepends=('python-setuptools' 'python-build' 'python-installer' 'python-wheel')
checkdepends=('python-pytest')
source=("https://files.pythonhosted.org/packages/source/${_name:0:1}/$_name/${_name//-/_}-$pkgver.tar.gz")
sha256sums=('35d5aab732746deb0f3d806a9261b47f0567410f5fa4ad8785e992d0df09f424')

build() {
  cd "$srcdir"/${_name//-/_}-$pkgver
  python -m build --wheel --no-isolation
}

check() {
  local pytest_options=(
    -vv
    --disable-warnings
    -p pytester
  )
  cd "$srcdir"/${_name//-/_}-$pkgver
  PYTHONPATH=$PWD pytest "${pytest_options[@]}" tests
}

package() {
  cd "$srcdir"/${_name//-/_}-$pkgver
  python -m installer --destdir="$pkgdir" dist/*.whl
}
